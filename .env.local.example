# ROOT LINGO — 环境变量样例
#
# 部署到 Vercel 时,把这些复制到 Vercel 项目设置 → Environment Variables
# 本地开发时,复制此文件为 .env.local 并填上真实值
#
# ============================================================
# 1. 用户认证(必填)
# ============================================================

# 用户名:密码 组,多组用逗号分隔
# 密码不能含 ":" 或 "," 或空格,其他符号(! @ # $ % ^ & * - _ + = . 等)都可以
APP_PASSWORDS=alice:my-strong-pw,bob:another-pw,jia:owner-pw

# JWT 签名密钥,至少 32 字符的随机串
# 生成方式:在终端跑 `openssl rand -base64 48` 或者随便敲一长串
SESSION_SECRET=replace-this-with-a-long-random-string-at-least-32-chars

# Session 有效期(天数),默认 30
SESSION_TTL_DAYS=30

# ============================================================
# 2. LLM API Keys(根据你想支持哪些模型,填对应的 Key)
# ============================================================

# Anthropic 官方(用于 Claude 系列直连;不填则走 OpenRouter 兜底)
ANTHROPIC_API_KEY=sk-ant-...

# DeepSeek 官方(用于 DeepSeek 系列直连;不填则走 OpenRouter 兜底)
DEEPSEEK_API_KEY=sk-...

# OpenRouter(几乎所有模型都能走它;OpenAI / Google / Qwen 系列必须走它)
# 申请地址:https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...
