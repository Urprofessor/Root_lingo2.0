# ROOT LINGO — 环境变量样例
#
# 部署到 Vercel 时,把这些复制到 Vercel 项目设置 → Environment Variables
# 本地开发时,复制此文件为 .env.local 并填上真实值

# ============================================================
# 1. 用户认证(必填)
# ============================================================

# 用户名:密码 组,多组用逗号分隔
# 密码不能含 ":" 或 "," 或空格
APP_PASSWORDS=alice:my-strong-pw,bob:another-pw

# JWT 签名密钥,至少 32 字符的随机串
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars

# Session 有效期(天数),默认 30
SESSION_TTL_DAYS=30

# ============================================================
# 2. LLM 接入(至少填 COMPATIBLE_API_KEY)
# ============================================================

# 【主力】部门统一网关 — OpenAI 兼容,一个 Key 调所有模型
# base_url 已写死在代码里:https://cliproxy.luteos.site/v1
# 所有模型优先走这个网关
COMPATIBLE_API_KEY=sk-...

# ============================================================
# 3. 兜底直连(可选 — 网关不可用时按顺序回退)
# ============================================================

# Anthropic 官方(Claude 兜底)
ANTHROPIC_API_KEY=

# DeepSeek 官方(DeepSeek 兜底)
DEEPSEEK_API_KEY=

# OpenRouter(各模型最终兜底)
OPENROUTER_API_KEY=
